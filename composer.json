{
    "name": "the-riptide/laravel-dynamic-text",
    "description": "A setup and dashboard to make text and translations easy to edit",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "text",
        "dynamic"
    ],
    "authors": [
        {
            "name": "Jelte ten Holt",
            "email": "jelte@theriptide.net",
            "homepage": "https://www.theriptide.net/",
            "role": "developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TheRiptide\\LaravelDynamicText\\DynamicTextServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "TheRiptide\\LaravelDynamicText\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TheRiptide\\LaravelDynamicText\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^3.0",
        "the-riptide/laravel-dashboard-components": "^0.2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
